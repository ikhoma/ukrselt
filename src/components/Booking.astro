---
/**
 * booking (Framer): фото + «Записатися» + форма. Остання секція сторінки (радіус знизу 40).
 * Форма — нова (SPEC §7.1): Ім'я (необов'язкове), Телефон (обов'язковий), «Записатися на діагностику».
 * Відправка: /api/contact (ADR-0004). Без JS — звичайний POST; з JS — fetch, стани кнопки, подія form_submit після успіху.
 */
import { Image } from 'astro:assets';
import { getLocale, useTranslations } from '../i18n';
import { getPage } from '../content/pages';
import { pageImage } from '../content/images';

interface Props {
  /** Ідентифікатор сторінки для події form_submit (SPEC §7.1). */
  service: string;
}
const { service } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const c = getPage(locale, 'booking');
const uid = `book-${service.replace(/[^a-z0-9]/gi, '-')}`;
---

<section class="booking" id="book">
  <div class="container">
    <div class="pic">
      <Image src={pageImage(c.image)} alt={c.imageAlt} widths={[360, 630, 960, 1260]} sizes="(max-width: 1199.98px) 100vw, 630px" format="webp" />
    </div>
    <div class="form-col">
      <h2 class="text-heading-2">{c.title}</h2>
      <p class="intro">{c.text}</p>
      <form class="form" method="post" action="/api/contact" data-booking-form data-service={service} novalidate>
        <label class="field">
          <span class="label">{c.nameLabel}</span>
          <span class="control"><input type="text" name="name" autocomplete="name" maxlength="100" placeholder={t('form.namePlaceholder')} /></span>
        </label>
        <label class="field">
          <span class="label">{c.phoneLabel}</span>
          <span class="control"><input type="tel" name="phone" autocomplete="tel" inputmode="tel" required maxlength="25" placeholder={t('form.phonePlaceholder')} aria-describedby={`${uid}-phone-error`} /></span>
          <span class="field-error" id={`${uid}-phone-error`} data-phone-error hidden>{t('form.phoneRequired')}</span>
        </label>
        <input type="hidden" name="service" value={service} />
        <input type="hidden" name="page" value={Astro.url.pathname} />
        <input type="hidden" name="elapsed" value="" data-elapsed />
        <!-- honeypot (ADR-0004) -->
        <input class="hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="submit" type="submit" data-submit data-text-idle={t('form.submit')} data-text-sending={t('form.sending')} data-text-success={t('form.success')}>
          <span class="submit-label" data-submit-label>{t('form.submit')}</span>
        </button>
        <p class="form-error" data-form-error role="alert" hidden>{t('form.error')}</p>
        <p class="note">{t('form.note')}</p>
      </form>
    </div>
  </div>
</section>

<style>
  .booking {
    position: relative;
    z-index: 1;
    padding: 80px 80px 160px;
    border-radius: 0 0 40px 40px;
    background: var(--color-almost-black);
  }
  .container {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .pic {
    flex: none;
    width: 630px;
    height: 560px;
    overflow: hidden;
    border-radius: 80px;
  }
  .pic :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .form-col {
    width: 630px;
    padding-left: 108px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .intro {
    font-size: var(--text-body-size);
    line-height: var(--text-body-line-height);
    color: var(--text-body-color);
  }
  .form {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .label {
    font-size: 16px;
    line-height: 22.4px;
    color: var(--color-light-grey);
  }
  .control {
    position: relative;
    display: flex;
    align-items: center;
    height: 56px;
    padding: 0 20px;
    border-radius: 20px;
    background-image: linear-gradient(rgb(54, 54, 55) 0%, rgb(50, 50, 51) 100%);
    box-shadow: 0 10px 30px 0 rgba(31, 31, 31, 0.1);
  }
  .control::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: inherit;
    pointer-events: none;
  }
  .control input {
    width: 100%;
    padding: 0;
    border: 0;
    outline: none;
    background: none;
    font-family: var(--font-family);
    /* 16px, а не 14px як у Framer: при меншому шрифті iOS Safari збільшує сторінку при фокусі на полі. */
    font-size: 16px;
    line-height: 20px;
    color: var(--color-clean-white);
  }
  .control input::placeholder {
    color: var(--color-somewhat-light-grey);
    opacity: 1;
  }
  .control:focus-within::after {
    border-color: rgba(255, 255, 255, 0.2); /* видимий фокус для клавіатури; у Framer фокус не виділявся */
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .submit {
    height: 70px;
    padding: 24px 32px;
    border: 0;
    border-radius: 40px;
    background: var(--color-ukrselt-blue);
    color: var(--color-clean-white);
    font-family: var(--font-family);
    font-size: 16px;
    line-height: 22.4px;
    cursor: pointer;
    transition: background-color var(--dur-hover) var(--ease-hover);
  }
  .submit:hover {
    background: var(--color-lighter-blue);
  }
  .submit[disabled] {
    cursor: default;
  }
  .submit[data-state='sending'] {
    background: var(--color-lighter-blue);
  }
  /* Мікроанімація зміни стану (SPEC §7.1, вигляд TBD): текст виїжджає знизу. */
  .submit-label {
    display: inline-block;
  }
  .submit-label.is-swapping {
    animation: label-in 350ms var(--ease-hover-pill) both;
  }
  @keyframes label-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .field-error,
  .form-error {
    font-size: 14px;
    line-height: 140%;
    color: #ff6b6b;
  }
  .control:has(input[aria-invalid='true'])::after {
    border-color: rgba(255, 107, 107, 0.6);
  }
  .note {
    font-size: 14px;
    line-height: 14px;
    color: var(--color-light-grey);
  }

  @media (max-width: 1439.98px) {
    .booking {
      padding: 80px 32px 160px;
    }
  }
  @media (max-width: 1199.98px) {
    .booking {
      padding: 40px 32px 80px;
    }
    .container {
      flex-direction: column;
      align-items: stretch;
    }
    .pic {
      width: 100%;
      height: auto;
      aspect-ratio: 630 / 560;
    }
    .form-col {
      width: 100%;
      padding-left: 0;
    }
    .intro {
      max-width: 630px;
    }
  }
  @media (max-width: 809.98px) {
    .booking {
      padding: 40px 15px 80px;
    }
    .pic {
      border-radius: 40px;
    }
  }
</style>

<script>
  type DL = { dataLayer?: Record<string, unknown>[] };
  const digits = (v: string) => v.replace(/\D/g, '');
  const validPhone = (v: string) => {
    const d = digits(v);
    const full = d.length === 10 && d.startsWith('0') ? `38${d}` : d;
    return full.length >= 10 && full.length <= 15;
  };

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-booking-form]')) {
    const phone = form.querySelector<HTMLInputElement>('input[name="phone"]')!;
    const phoneError = form.querySelector<HTMLElement>('[data-phone-error]')!;
    const formError = form.querySelector<HTMLElement>('[data-form-error]')!;
    const button = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const elapsed = form.querySelector<HTMLInputElement>('[data-elapsed]')!;
    let startedAt = 0;
    let resetTimer = 0;

    const setLabel = (text: string) => {
      label.textContent = text;
      label.classList.remove('is-swapping');
      void label.offsetWidth;
      label.classList.add('is-swapping');
    };
    const setState = (state: 'idle' | 'sending' | 'success') => {
      button.dataset.state = state;
      button.disabled = state !== 'idle';
      setLabel(button.dataset[`text${state[0].toUpperCase()}${state.slice(1)}` as 'textIdle'] ?? '');
    };
    const showPhoneError = (show: boolean) => {
      phoneError.hidden = !show;
      phone.setAttribute('aria-invalid', String(show));
    };

    form.addEventListener('focusin', () => (startedAt ||= Date.now()));
    form.addEventListener('input', () => (startedAt ||= Date.now()));
    phone.addEventListener('input', () => phoneError.hidden || showPhoneError(!validPhone(phone.value)));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (button.disabled) return;
      formError.hidden = true;
      if (!validPhone(phone.value)) {
        showPhoneError(true);
        phone.focus();
        return;
      }
      showPhoneError(false);
      elapsed.value = String(startedAt ? Date.now() - startedAt : '');
      setState('sending');
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
        const data = await res.json().catch(() => ({ ok: false }));
        if (!res.ok || !data.ok) {
          if (data.error === 'phone') {
            setState('idle');
            showPhoneError(true);
            return;
          }
          throw new Error('send');
        }
        const w = window as unknown as DL;
        (w.dataLayer ||= []).push({ event: 'form_submit', service: form.dataset.service });
        setState('success');
        form.reset();
        startedAt = 0;
        clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => setState('idle'), 6000);
      } catch {
        setState('idle');
        formError.hidden = false;
      }
    });
  }
</script>

---
/**
 * booking (Framer): фото + «Записатися» + форма. Остання секція сторінки (радіус знизу 40).
 * Форма — нова (SPEC §7.1): Ім'я (необов'язкове), Телефон (обов'язковий), «Записатися на діагностику».
 * Відправка: /api/contact (ADR-0004). Без JS — звичайний POST; з JS — fetch, стани кнопки, подія form_submit після успіху.
 */
import { Image } from 'astro:assets';
import { getLocale, useTranslations } from '../i18n';
import { getPage } from '../content/pages';
import { pageImage } from '../content/images';

interface Props {
  /** Ідентифікатор сторінки для події form_submit (SPEC §7.1). */
  service: string;
  /** section — блок унизу сторінки (#book); overlay — той самий блок в оверлеї «Записатися» (BookingOverlay). */
  variant?: 'section' | 'overlay';
  /** Текст кнопки: «Записатися на прийом» (за замовчуванням) або «Записатися на діагностику» (сторінки послуг під рекламу). */
  submit?: 'default' | 'diagnostics';
  /** booking — Ім'я + Телефон; callback — «Замовити дзвінок»: лише Телефон, поле й кнопка в один рядок (рішення Івана 31.10). */
  kind?: 'booking' | 'callback';
}
const { service, variant = 'section', submit = 'default', kind = 'booking' } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const c = getPage(locale, 'booking');
const submitText = t(kind === 'callback' ? 'form.submitCallback' : submit === 'diagnostics' ? 'form.submitDiagnostics' : 'form.submit');
const uid = `book-${variant === 'overlay' ? `overlay-${kind}` : service.replace(/[^a-z0-9]/gi, '-')}`;
const callback = kind === 'callback';
const title = callback ? c.callback.title : c.title;
const text = callback ? c.callback.text : c.text;
const phoneLabel = callback ? c.callback.phoneLabel : c.phoneLabel;
---

<section class:list={['booking', `booking--${variant}`, `booking--${kind}`]} id={variant === 'section' ? 'book' : undefined}>
  <div class="container">
    <div class="pic">
      <Image src={pageImage(c.image)} alt={c.imageAlt} widths={[360, 630, 960, 1260]} sizes="(max-width: 1199.98px) 100vw, 630px" format="webp" />
    </div>
    <div class="form-col">
      <h2 class="text-heading-2">{title}</h2>
      <p class="intro">{text}</p>
      <form class="form" method="post" action="/api/contact" data-booking-form data-service={service} novalidate>
        <div class="fields">
        {!callback && (
        <label class="field">
          <span class="label">{c.nameLabel}</span>
          <span class="control"><input type="text" name="name" autocomplete="name" maxlength="100" placeholder={t('form.namePlaceholder')} /></span>
        </label>
        )}
        <label class="field">
          <span class="label">{phoneLabel}</span>
          <span class="control"><input type="tel" name="phone" autocomplete="tel" inputmode="tel" required maxlength="19" value="+38 (0" data-phone-prefix="+38 (0" placeholder={t('form.phonePlaceholder')} aria-describedby={`${uid}-phone-error`} /></span>
          <span class="field-error" id={`${uid}-phone-error`} data-phone-error hidden>{t('form.phoneRequired')}</span>
        </label>
        </div>
        <input type="hidden" name="service" value={service} />
        <input type="hidden" name="page" value={Astro.url.pathname} />
        <input type="hidden" name="elapsed" value="" data-elapsed />
        <!-- honeypot (ADR-0004) -->
        <input class="hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="submit" type="submit" data-submit data-text-idle={submitText} data-text-sending={t('form.sending')} data-text-success={t('form.success')}>
          <span class="submit-label" data-submit-label>{submitText}</span>
        </button>
        <p class="form-error" data-form-error role="alert" hidden>{t('form.error')}</p>
        {!callback && <p class="note">{t('form.note')}</p>}
      </form>
    </div>
  </div>
</section>

<style>
  .booking {
    position: relative;
    z-index: 1;
    padding: 80px 80px 160px;
    border-radius: 0 0 40px 40px;
    background: var(--color-almost-black);
  }
  .container {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .pic {
    flex: none;
    width: 630px;
    height: 560px;
    overflow: hidden;
    border-radius: 80px;
  }
  .pic :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .form-col {
    width: 630px;
    padding-left: 108px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .intro {
    font-size: var(--text-body-size);
    line-height: var(--text-body-line-height);
    color: var(--text-body-color);
  }
  .form {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  /* Ім'я і Телефон в один рядок (рішення Івана 31.10); на телефоні — одне під одним. */
  .fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    align-items: start;
  }
  .field {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .label {
    font-size: 16px;
    line-height: 22.4px;
    color: var(--color-light-grey);
  }
  .control {
    position: relative;
    display: flex;
    align-items: center;
    height: 56px;
    padding: 0 20px;
    border-radius: 20px;
    background-image: linear-gradient(rgb(54, 54, 55) 0%, rgb(50, 50, 51) 100%);
    box-shadow: 0 10px 30px 0 rgba(31, 31, 31, 0.1);
  }
  .control::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: inherit;
    pointer-events: none;
  }
  .control input {
    width: 100%;
    padding: 0;
    border: 0;
    outline: none;
    background: none;
    font-family: var(--font-family);
    /* 16px, а не 14px як у Framer: при меншому шрифті iOS Safari збільшує сторінку при фокусі на полі. */
    font-size: 16px;
    line-height: 20px;
    color: var(--color-clean-white);
  }
  .control input::placeholder {
    color: var(--color-somewhat-light-grey);
    opacity: 1;
  }
  .control:focus-within::after {
    border-color: rgba(255, 255, 255, 0.2); /* видимий фокус для клавіатури; у Framer фокус не виділявся */
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .submit {
    height: 70px;
    padding: 24px 32px;
    border: 0;
    border-radius: 40px;
    background: var(--color-ukrselt-blue);
    color: var(--color-clean-white);
    font-family: var(--font-family);
    font-size: 16px;
    line-height: 22.4px;
    cursor: pointer;
    transition: background-color var(--dur-hover) var(--ease-hover);
  }
  .submit:hover {
    background: var(--color-lighter-blue);
  }
  .submit[disabled] {
    cursor: default;
  }
  .submit[data-state='sending'] {
    background: var(--color-lighter-blue);
  }
  /* Мікроанімація зміни стану (SPEC §7.1, вигляд TBD): текст виїжджає знизу. */
  .submit-label {
    display: inline-block;
  }
  .submit-label.is-swapping {
    animation: label-in 350ms var(--ease-hover-pill) both;
  }
  @keyframes label-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .field-error,
  .form-error {
    font-size: 14px;
    line-height: 140%;
    color: #ff6b6b;
  }
  .control:has(input[aria-invalid='true'])::after {
    border-color: rgba(255, 107, 107, 0.6);
  }
  .note {
    font-size: 14px;
    line-height: 14px;
    color: var(--color-light-grey);
  }

  @media (max-width: 1439.98px) {
    .booking {
      padding: 80px 32px 160px;
    }
  }
  @media (max-width: 1199.98px) {
    .booking {
      padding: 40px 32px 80px;
    }
    .container {
      flex-direction: column;
      align-items: stretch;
    }
    .pic {
      width: 100%;
      height: auto;
      aspect-ratio: 630 / 560;
    }
    .form-col {
      width: 100%;
      padding-left: 0;
    }
    .intro {
      max-width: 630px;
    }
  }
  /* «Замовити дзвінок» (макет Івана 31.10): одне поле, кнопка в тому ж рядку й тієї ж висоти, що поле (56). */
  .booking--callback .form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 16px;
  }
  .booking--callback .fields {
    grid-template-columns: minmax(0, 1fr);
  }
  .booking--callback .submit {
    align-self: start;
    margin-top: 32.4px; /* висота підпису поля (22.4) + відступ 10 — кнопка на рівні поля */
    height: 56px;
    padding: 0 24px;
  }
  .booking--callback .form-error {
    grid-column: 1 / -1;
  }
  /* Оверлей (Framer: Form у #overlay): Tablet — картка 632 без фото, Phone — на весь екран без фото. */
  @media (max-width: 1199.98px) {
    .booking--overlay {
      width: 632px;
      max-width: 100%;
      margin: 0 auto;
    }
    .booking--overlay .pic {
      display: none;
    }
  }
  @media (max-width: 809.98px) {
    .booking {
      padding: 40px 15px 80px;
    }
    .fields {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .booking--callback .form {
      grid-template-columns: minmax(0, 1fr);
    }
    .booking--callback .submit {
      margin-top: 0;
      height: 70px;
    }
    .booking--overlay {
      width: 100%;
      min-height: 100%;
    }
    .pic {
      border-radius: 40px;
    }
  }
</style>

<script>
  type DL = { dataLayer?: Record<string, unknown>[] };
  const digits = (v: string) => v.replace(/\D/g, '');
  /** Український номер: рівно 10 цифр після «+38» (маска поля); інші країни — 10–15 цифр. */
  const validPhone = (v: string) => {
    const d = digits(v);
    if (d.startsWith('380') || (d.length <= 10 && d.startsWith('0'))) return (d.startsWith('38') ? d.slice(2) : d).length === 10;
    return d.length >= 10 && d.length <= 15;
  };

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-booking-form]')) {
    const phone = form.querySelector<HTMLInputElement>('input[name="phone"]')!;
    const phoneError = form.querySelector<HTMLElement>('[data-phone-error]')!;
    const formError = form.querySelector<HTMLElement>('[data-form-error]')!;
    const button = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const elapsed = form.querySelector<HTMLInputElement>('[data-elapsed]')!;
    let startedAt = 0;
    let resetTimer = 0;

    const setLabel = (text: string) => {
      label.textContent = text;
      label.classList.remove('is-swapping');
      void label.offsetWidth;
      label.classList.add('is-swapping');
    };
    const setState = (state: 'idle' | 'sending' | 'success') => {
      button.dataset.state = state;
      button.disabled = state !== 'idle';
      setLabel(button.dataset[`text${state[0].toUpperCase()}${state.slice(1)}` as 'textIdle'] ?? '');
    };
    const showPhoneError = (show: boolean) => {
      phoneError.hidden = !show;
      phone.setAttribute('aria-invalid', String(show));
    };

    // Маска як у плейсхолдері: +38 (0XX) XXX-XX-XX (рішення Івана 31.10). Поле вже містить «+38 (0», курсор після нього.
    const prefix = phone.dataset.phonePrefix ?? '';
    /** Цифри національного номера (10, з першим «0») з будь-якого введеного вигляду. */
    const national = (v: string) => {
      let d = digits(v);
      if (d.startsWith('38')) d = d.slice(2);
      while (d.startsWith('00')) d = d.slice(1);
      if (d && !d.startsWith('0')) d = '0' + d;
      return d.slice(0, 10);
    };
    const format = (d: string) => {
      if (!d) return '';
      let out = '+38 (' + d.slice(0, 3);
      if (d.length > 3) out += ') ' + d.slice(3, 6);
      if (d.length > 6) out += '-' + d.slice(6, 8);
      if (d.length > 8) out += '-' + d.slice(8, 10);
      return out;
    };
    /** Позиція курсора після n-ї цифри національного номера у відформатованому рядку. */
    const caretAfterDigit = (str: string, n: number) => {
      if (n <= 0) return prefix.length;
      let seen = 0;
      // перші «3» і «8» у «+38» — не національні цифри
      for (let i = 4; i < str.length; i++) if (/\d/.test(str[i]) && ++seen === n) return i + 1;
      return str.length;
    };
    const apply = (keepCaret: boolean) => {
      const before = phone.selectionStart ?? phone.value.length;
      const digitsBefore = national(phone.value.slice(0, before)).length;
      const d = national(phone.value) || '0';
      phone.value = format(d);
      const pos = keepCaret ? Math.max(prefix.length, caretAfterDigit(phone.value, digitsBefore)) : phone.value.length;
      phone.setSelectionRange(pos, pos);
    };
    phone.addEventListener('focus', () => {
      if (!phone.value) phone.value = prefix;
      requestAnimationFrame(() => {
        if ((phone.selectionStart ?? 0) < prefix.length || phone.selectionStart === phone.selectionEnd) phone.setSelectionRange(phone.value.length, phone.value.length);
      });
    });
    phone.addEventListener('click', () => {
      if ((phone.selectionStart ?? 0) < prefix.length) phone.setSelectionRange(prefix.length, prefix.length);
    });
    phone.addEventListener('blur', () => {
      if (phone.value === prefix) phone.value = '';
    });
    // Backspace на «)», пробілі чи «-» стирає цифру перед ним; префікс «+38 (0» не стирається.
    phone.addEventListener('keydown', (e) => {
      if (e.key !== 'Backspace') return;
      const s = phone.selectionStart ?? 0;
      if (s !== phone.selectionEnd) return;
      if (s <= prefix.length) {
        e.preventDefault();
        return;
      }
      let i = s;
      while (i > prefix.length && !/\d/.test(phone.value[i - 1])) i--;
      if (i !== s && i > prefix.length) {
        e.preventDefault();
        phone.value = phone.value.slice(0, i - 1) + phone.value.slice(s);
        phone.setSelectionRange(i - 1, i - 1);
        apply(true);
      }
    });
    phone.addEventListener('input', (e) => {
      const ie = e as InputEvent;
      const atEnd = (phone.selectionStart ?? 0) >= phone.value.length;
      apply(!atEnd && ie.inputType !== 'insertFromPaste');
    });

    form.addEventListener('focusin', () => (startedAt ||= Date.now()));
    form.addEventListener('input', () => (startedAt ||= Date.now()));
    phone.addEventListener('input', () => phoneError.hidden || showPhoneError(!validPhone(phone.value)));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (button.disabled) return;
      formError.hidden = true;
      if (!validPhone(phone.value)) {
        showPhoneError(true);
        phone.focus();
        return;
      }
      showPhoneError(false);
      elapsed.value = String(startedAt ? Date.now() - startedAt : '');
      setState('sending');
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
        const data = await res.json().catch(() => ({ ok: false }));
        if (!res.ok || !data.ok) {
          if (data.error === 'phone') {
            setState('idle');
            showPhoneError(true);
            return;
          }
          throw new Error('send');
        }
        const w = window as unknown as DL;
        (w.dataLayer ||= []).push({ event: 'form_submit', service: form.dataset.service });
        setState('success');
        form.reset();
        startedAt = 0;
        clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => setState('idle'), 6000);
      } catch {
        setState('idle');
        formError.hidden = false;
      }
    });
  }
</script>

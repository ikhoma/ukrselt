---
/**
 * Оверлей форми (Framer: #overlay з компонентом Form). «Записатися» — кнопка в шапці ([data-open-booking]);
 * «Замовити дзвінок» — кнопка в Hero головної ([data-open-callback]), лише поле телефону (рішення Івана 31.10).
 * Desktop: темний фон на весь екран і блок booking з фото по центру; Tablet: картка 632 без фото; Phone: на весь екран без фото.
 * Закриття: хрестик (48×48, top/right 40, на телефоні 15) або Escape. Поява (заміряно): фон 0.25 с, вміст 0.18 с.
 * Нативний <dialog>: фокус усередині, Escape, доступність.
 */
import Booking from './Booking.astro';
import { getLocale } from '../i18n';
import { getPage } from '../content/pages';

interface Props {
  /** booking — «Записатися» з шапки ([data-open-booking]); callback — «Замовити дзвінок» з Hero ([data-open-callback]). */
  kind?: 'booking' | 'callback';
  /** Демо-форма (прототипи): нічого не надсилає. */
  demo?: boolean;
}
const { kind = 'booking', demo = false } = Astro.props;
const path = Astro.url.pathname.replace(/^\/|\/$/g, '');
const service = (path || 'home') + (kind === 'callback' ? '/callback' : '');
const c = getPage(getLocale(Astro.url), 'booking');
const label = kind === 'callback' ? c.callback.ariaLabel : c.title;
---

<dialog class="booking-overlay" data-booking-overlay={kind} aria-label={label} tabindex="-1" data-lenis-prevent>
  <button class="close" type="button" data-booking-close aria-label="Закрити"><span></span><span></span></button>
  <div class="content">
    <Booking service={service} variant="overlay" kind={kind} demo={demo} />
  </div>
</dialog>

<style>
  .booking-overlay {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-almost-black);
    color: inherit;
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transition: opacity 250ms ease-out;
  }
  .booking-overlay[open] {
    display: flex;
  }
  .booking-overlay:focus {
    outline: none;
  }
  .booking-overlay::backdrop {
    background: transparent;
  }
  .booking-overlay.is-open {
    opacity: 1;
  }
  .content {
    width: 100%;
    margin: auto 0; /* по центру вертикально, але з прокруткою, якщо не влазить */
    opacity: 0;
    transition: opacity 180ms ease-out;
  }
  .booking-overlay.is-open .content {
    opacity: 1;
  }
  /* Хрестик стоїть там, де бургер у шапці (рішення Івана 06.11): ≤1279 — точно на місці бургера (48×48),
     на десктопі бургера нема — по правому полю сітки й по центру кнопки «Записатися» в шапці (центр 112). */
  .close {
    position: fixed;
    z-index: 2; /* вище за .booking (z-index 1) */
    top: 88px;
    right: var(--grid-pad);
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .close span {
    position: absolute;
    top: 23px;
    left: 12px;
    width: 24px;
    height: 2px;
    border-radius: 1px;
    background: var(--color-clean-white);
    transform: rotate(45deg);
  }
  .close span + span {
    transform: rotate(-45deg);
  }
  /* Hover/фокус як у посилань TopBar і футера: колір гасне до greyish, 200 мс (у Framer hover хрестика не було). */
  .close span {
    transition: background-color var(--dur-hover) var(--ease-hover);
  }
  .close:hover span,
  .close:focus-visible span {
    background: var(--color-greyish);
  }
  .close:focus-visible {
    outline: none;
  }
  @media (max-width: 1279.98px) {
    .close {
      top: 66px;
      right: 28px;
    }
  }
  @media (max-width: 809.98px) {
    .booking-overlay {
      --booking-close-center: 80px;
    }
    .close {
      top: calc(var(--booking-close-center) - 24px);
      right: 11px;
    }
    .content {
      margin: 0;
      min-height: 100%;
      display: flex;
    }
  }
</style>

<script>
  // Кожен оверлей відкривається своїм тригером: [data-open-booking] або [data-open-callback].
  for (const dialog of document.querySelectorAll<HTMLDialogElement>('[data-booking-overlay]')) {
    const kind = dialog.dataset.bookingOverlay;
    const lock = (on: boolean) => {
      document.documentElement.style.overflow = on ? 'hidden' : '';
      document.dispatchEvent(new CustomEvent(on ? 'ukrselt:scroll-lock' : 'ukrselt:scroll-unlock'));
    };
    const open = () => {
      if (dialog.open) return;
      dialog.showModal();
      // Браузер сам фокусує перший елемент (часто поле телефону). Фокусуємо діалог: Tab веде далі по формі (Іван 31.10).
      dialog.focus();
      lock(true);
      requestAnimationFrame(() => dialog.classList.add('is-open'));
    };
    const close = () => {
      if (!dialog.open) return;
      dialog.classList.remove('is-open');
      setTimeout(() => {
        dialog.close();
        lock(false);
      }, 250);
    };
    document.addEventListener('click', (e) => {
      if (!(e.target as Element).closest(`[data-open-${kind}]`)) return;
      e.preventDefault();
      open();
    });
    dialog.querySelector('[data-booking-close]')!.addEventListener('click', close);
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
  }
</script>

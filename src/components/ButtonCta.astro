---
/**
 * buttons/cta (Framer): синя кнопка-пігулка. Єдиний компонент для всіх синіх кнопок сайту (рішення Івана 06.11).
 * Розміри: s — 48 (16/20, текст 14/16), m — 56 (16/24, текст 16/24), l — 64 (20/24, текст 16/24).
 * Ширина завжди за вмістом (без фіксованих ширин); розтягнути на всю ширину може тільки батьківський лейаут.
 * as="button" — для кнопки відправки форми; action — який оверлей відкриває посилання.
 */
import type { HTMLAttributes } from 'astro/types';
import { bookHref } from '../data/site';

type Props = {
  size?: 's' | 'm' | 'l';
  as?: 'a' | 'button';
  href?: string;
  action?: 'booking' | 'callback' | 'none';
  class?: string;
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'class' | 'href'>;

const { size = 'l', as = 'a', href = bookHref, action = 'booking', class: cls, ...rest } = Astro.props;
const classes = ['cta', `cta--${size}`, cls];
---

{
  as === 'button' ? (
    <button class:list={classes} {...rest}><slot /></button>
  ) : (
    <a
      class:list={classes}
      href={href}
      data-open-booking={action === 'booking' ? '' : undefined}
      data-open-callback={action === 'callback' ? '' : undefined}
      {...rest}
    ><slot /></a>
  )
}

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    border: 0;
    border-radius: 48px;
    background: var(--color-ukrselt-blue);
    color: var(--color-clean-white);
    font-family: var(--font-family);
    font-weight: 400;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--dur-hover) var(--ease-hover);
  }
  .cta:hover {
    background: var(--color-lighter-blue);
  }
  .cta--l {
    height: 64px;
    padding: 20px 24px;
    font-size: 16px;
    line-height: 24px;
  }
  .cta--m {
    height: 56px;
    padding: 16px 24px;
    font-size: 16px;
    line-height: 24px;
  }
  .cta--s {
    height: 48px;
    padding: 16px 20px;
    font-size: 14px;
    line-height: 16px;
  }
</style>

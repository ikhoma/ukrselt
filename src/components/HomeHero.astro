---
/**
 * Hero головної (Framer: Hero → hero / Transition*). 900px, фото cover + оверлей-градієнт (картинка з Framer).
 * Заголовок: «Змінюємо» + text loop (слова виїжджають з-під маски; анімація — етап 6, ADR-0005).
 * Для пошуковиків і читачів екрана — один H1 з повною фразою; візуальний заголовок aria-hidden.
 * Шапка сайту лежить поверх (PageLayout).
 */
import { keepShortWords } from '../i18n/typography';
import { Image } from 'astro:assets';
import hero from '../assets/home/hero.png';
import overlay from '../assets/home/hero-overlay.png';
import { localizePath, getLocale } from '../i18n';

interface Props {
  title: string;
  words: string[];
  h1: string;
  text: string;
  cta: string;
}
const { title, words, h1, text, cta } = Astro.props;
const locale = getLocale(Astro.url);
import ButtonCta from './ButtonCta.astro';
---

<section class="hero">
  <div class="hero-image" data-parallax="0.1">
    <Image src={hero} alt="" widths={[780, 1440, 2048]} sizes="(max-width: 1199.98px) 300vw, 100vw" format="webp" loading="eager" fetchpriority="high" data-critical />
  </div>
  <Image class="overlay" src={overlay} alt="" widths={[1440]} sizes="100vw" format="webp" loading="eager" data-critical />
  <div class="title">
    <h1 class="sr-only">{h1}</h1>
    <div class="heading" aria-hidden="true">
      <span class="lead-word">{title}</span>
      <span class="text-loop" data-text-loop>
        <span class="stack" data-text-loop-stack>
          {[...words, words[0]].map((w) => <span class="word">{w}</span>)}
        </span>
      </span>
    </div>
    <div class="row">
      <p class="text">{keepShortWords(text)}</p>
      <ButtonCta size="l" href={localizePath('/', locale) + '#book'} action="callback">{cta}</ButtonCta>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh; /* як у Framer: Hero на всю висоту вікна, TopBar лежить поверх */
    overflow: hidden;
    background: var(--color-almost-black);
  }
  /* Фото прив'язане до низу Hero (заміряно: низ фото на 70 px нижче за низ Hero), висота як у Framer (960),
     але не менша за сам Hero: у високому вузькому вікні (половина екрана Mac, ~1230×1240) фото інакше
     не діставало до верху і лишалась темна смуга (так само й на живому сайті). Рішення Івана 04.11. */
  .hero-image {
    position: absolute;
    bottom: -70px;
    left: 0;
    right: 0;
    height: max(960px, calc(100% + 70px));
  }
  .hero-image :global(img),
  .overlay {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .overlay {
    position: absolute;
    inset: 0;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .title {
    position: absolute;
    z-index: 2;
    left: 80px;
    bottom: 80px;
    width: 867px;
    display: flex;
    flex-direction: column;
    gap: var(--hero-title-gap);
  }
  .heading {
    display: flex;
    gap: 22px;
    font-size: 96px;
    line-height: 130%;
    letter-spacing: -3px;
    font-weight: 300;
    color: #fff;
  }
  .text-loop {
    position: relative;
    display: block;
    overflow: hidden;
    height: 1.3em;
  }
  .stack {
    display: block;
    will-change: transform;
  }
  .word {
    display: block;
    height: 1.3em;
    white-space: nowrap;
  }
  .row {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }
  .text {
    width: 414px;
    font-size: var(--text-body-size);
    line-height: var(--text-body-line-height);
    color: #fdfdfe;
  }

  @media (max-width: 1439.98px) {
    .title {
      left: 32px;
    }
  }
  @media (max-width: 1199.98px) {
    .hero-image {
      left: -443px;
      right: -210px;
      bottom: 0;
      height: max(1119px, 100%);
    }
    .title {
      width: 630px;
    }
    .heading {
      flex-direction: column;
      gap: 0;
      font-size: 72px;
    }
    .lead-word {
      line-height: 57.6px;
      letter-spacing: -1.44px;
      color: var(--color-clean-white);
    }
    .row {
      flex-direction: column;
    }
    .text {
      width: auto;
    }
  }
  @media (max-width: 809.98px) {
    /* Phone: фото прив'язане до верху (під TopBar), висота фіксована. */
    .hero-image {
      top: 48px;
      bottom: auto;
      left: -303px;
      right: -454px;
      height: 765px;
    }
    .title {
      left: 15px;
      width: 321px;
    }
  }
</style>

---
/**
 * Послуги на головній — експеримент (гілка experiment/home-services, ідея Івана 05.11).
 * Референс: секція «Sélection de projets» на archi-malinstudio.com — секція закріплена на висоту екрана,
 * горизонтальна стрічка квадратних фото з підписом «назва … номер» під час прокрутки їде вліво,
 * угорі праворуч — короткий заголовок і текст, унизу — великий заголовок на всю ширину.
 * Без JS або при «зменшити рух» стрічка просто гортається вбік (overflow-x).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BtnSecondary from './BtnSecondary.astro';

interface Props {
  label: string;
  text: string;
  cta: string;
  href: string;
  bigTitle: string;
  items: { title: string; image: ImageMetadata; alt: string; href: string }[];
}
const { label, text, cta, href, bigTitle, items } = Astro.props;
---

<section class="home-services" data-hscroll>
  <div class="sticky">
    <div class="intro">
      <h2 class="label">{label}</h2>
      <div class="intro-body">
        <p class="text">{text}</p>
        <BtnSecondary href={href} label={cta} />
      </div>
    </div>
    <div class="viewport">
      <ul class="strip" data-hscroll-strip>
        {
          items.map((it, i) => (
            <li>
              <a class="item" href={it.href}>
                <span class="pic">
                  <Image src={it.image} alt={it.alt} widths={[300, 450, 600]} sizes="(max-width: 809.98px) 220px, 300px" format="webp" loading="lazy" />
                </span>
                <span class="caption">
                  <span class="name">{it.title}</span>
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <p class="big" aria-hidden="true">{bigTitle}</p>
  </div>
</section>

<style>
  .home-services {
    position: relative;
    background: var(--color-almost-black);
  }
  .sticky {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 120px 0 40px;
  }
  /* З JS: секція вища за екран на довжину ходу стрічки (--travel), вміст закріплений на висоту екрана. */
  :global(html.js) .home-services.is-pinned {
    height: calc(100vh + var(--travel, 0px));
  }
  :global(html.js) .home-services.is-pinned .sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    justify-content: center;
    padding: 0;
    overflow: hidden;
  }

  .intro {
    display: flex;
    justify-content: flex-end;
    gap: 32px;
    padding: 0 80px;
  }
  .label {
    flex: 0 0 auto;
    max-width: 240px;
    margin: 0;
    font-size: var(--text-heading-4-size);
    line-height: var(--text-heading-4-line-height);
    font-weight: var(--text-heading-4-weight);
    color: var(--color-clean-white);
  }
  .intro-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    max-width: 360px;
  }
  .text {
    margin: 0;
    font-size: var(--text-body-size);
    line-height: var(--text-body-line-height);
    color: var(--text-body-color);
  }

  .viewport {
    overflow-x: auto;
    scrollbar-width: none;
  }
  .viewport::-webkit-scrollbar {
    display: none;
  }
  :global(html.js) .is-pinned .viewport {
    overflow: visible;
  }
  .strip {
    display: flex;
    gap: 20px;
    width: max-content;
    margin: 0;
    padding: 0 80px;
    list-style: none;
    will-change: transform;
  }
  .item {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: clamp(200px, 32vh, 300px);
    color: var(--color-clean-white);
    text-decoration: none;
  }
  .pic {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 40px;
  }
  .pic :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 550ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .item:hover .pic :global(img) {
    transform: scale(1.04);
  }
  .caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    font-size: var(--text-body-size);
    line-height: var(--text-body-line-height);
  }
  .num {
    flex: none;
    color: var(--color-somewhat-light-grey);
  }
  .big {
    margin: 0;
    padding: 0 80px;
    /* Великий заголовок і картки залежать і від ширини, і від висоти екрана — щоб закріплений блок вміщався у вікно. */
    font-size: clamp(72px, min(14vw, 21vh), 220px);
    line-height: 1;
    font-weight: 300;
    letter-spacing: -0.04em;
    color: var(--color-clean-white);
    white-space: nowrap;
  }

  @media (max-width: 1439.98px) {
    .intro,
    .strip,
    .big {
      padding-left: 32px;
      padding-right: 32px;
    }
  }
  @media (max-width: 809.98px) {
    .sticky {
      gap: 24px;
    }
    :global(html.js) .home-services.is-pinned .sticky {
      gap: 20px;
    }
    .intro {
      flex-direction: column;
      gap: 12px;
      padding: 0 16px;
    }
    .intro-body {
      max-width: none;
    }
    .strip {
      gap: 12px;
      padding: 0 16px;
    }
    .item {
      width: min(220px, 28vh);
      gap: 12px;
    }
    .pic {
      border-radius: 24px;
    }
    .big {
      padding: 0 16px;
      font-size: min(26vw, 12vh);
    }
  }
</style>

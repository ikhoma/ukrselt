---
/**
 * Послуги на головній — експеримент (гілка experiment/home-services, ідея Івана 05.11).
 * Референс: секція «Sélection de projets» на archi-malinstudio.com — секція закріплена на висоту екрана,
 * горизонтальна стрічка квадратних фото з підписом «назва … номер» під час прокрутки їде вліво,
 * унизу в ряд — заголовок «Послуги» (Heading 1) і опис з кнопкою. Без номерів і підзаголовка;
 * назви напрямів — Heading 4, як назви пунктів у перевагах (рішення Івана 05.11).
 * Без JS або при «зменшити рух» стрічка просто гортається вбік (overflow-x).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BtnSecondary from './BtnSecondary.astro';

interface Props {
  text: string;
  cta: string;
  href: string;
  bigTitle: string;
  items: { title: string; image: ImageMetadata; alt: string; href: string }[];
}
const { text, cta, href, bigTitle, items } = Astro.props;
---

<section class="home-services" data-hscroll>
  <div class="sticky">
    <div class="viewport">
      <ul class="strip" data-hscroll-strip>
        {
          items.map((it) => (
            <li>
              <a class="item" href={it.href}>
                <span class="pic">
                  <Image src={it.image} alt={it.alt} widths={[280, 420, 560, 840]} sizes="(max-width: 809.98px) 280px, 420px" format="webp" loading="lazy" />
                </span>
                <span class="caption">{it.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="bottom">
      <h2 class="text-heading-1 big">{bigTitle}</h2>
      <div class="intro-body">
        <p class="text">{text}</p>
        <BtnSecondary href={href} label={cta} />
      </div>
    </div>
  </div>
</section>

<style>
  .home-services {
    position: relative;
    background: var(--color-almost-black);
  }
  .sticky {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 120px 0 40px;
  }
  /* З JS: секція вища за екран на довжину ходу стрічки (--travel), вміст закріплений на висоту екрана. */
  :global(html.js) .home-services.is-pinned {
    height: calc(100vh + var(--travel, 0px));
  }
  :global(html.js) .home-services.is-pinned .sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    justify-content: center;
    padding: 0;
    overflow: hidden;
  }

  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    padding: 0 80px;
  }
  .intro-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    max-width: 360px;
  }
  .text {
    margin: 0;
    font-size: var(--text-body-size);
    line-height: var(--text-body-line-height);
    color: var(--text-body-color);
  }

  .viewport {
    overflow-x: auto;
    scrollbar-width: none;
  }
  .viewport::-webkit-scrollbar {
    display: none;
  }
  :global(html.js) .is-pinned .viewport {
    overflow: visible;
  }
  .strip {
    display: flex;
    gap: 20px;
    width: max-content;
    margin: 0;
    padding: 0 80px;
    list-style: none;
    will-change: transform;
  }
  .item {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: clamp(240px, 46vh, 420px);
    color: var(--color-clean-white);
    text-decoration: none;
  }
  /* Скруглення й відступи — як у картках «Команди» (CardTeam): 80 / 40 (≤1199), 20 між картками, 16 до назви. */
  .pic {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 80px;
  }
  .pic :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 550ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .item:hover .pic :global(img) {
    transform: scale(1.04);
  }
  /* Як назви пунктів у перевагах (CheckList): Heading 4. */
  .caption {
    font-size: var(--text-heading-4-size);
    line-height: var(--text-heading-4-line-height);
    font-weight: var(--text-heading-4-weight);
    color: var(--text-heading-4-color);
  }
  .big {
    margin: 0;
    white-space: nowrap;
  }

  @media (max-width: 1439.98px) {
    .bottom,
    .strip {
      padding-left: 32px;
      padding-right: 32px;
    }
  }
  @media (max-width: 1199.98px) {
    .pic {
      border-radius: 40px;
    }
  }
  @media (max-width: 809.98px) {
    .sticky {
      gap: 24px;
    }
    :global(html.js) .home-services.is-pinned .sticky {
      gap: 20px;
    }
    .bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      padding: 0 16px;
    }
    .intro-body {
      max-width: none;
    }
    .strip {
      padding: 0 16px;
    }
    .item {
      width: min(280px, 38vh);
    }

  }
</style>

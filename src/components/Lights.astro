---
/**
 * lights (Framer): два розмиті світлі кола (circle r100 у 600×600, blur 100, opacity 0.2 × 0.5) по боках секції.
 * size — розмір кола; offset — наскільки коло виходить за край секції.
 */
interface Props {
  size?: number;
  top?: number;
  offset?: number;
  class?: string;
}
const { size = 800, top = 0, offset = 400, class: cls } = Astro.props;
const svg = `<svg viewBox="0 0 600 600" fill="none" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%"><g opacity="0.2" filter="url(#light-blur)"><circle cx="300" cy="300" r="100" fill="#fefefe"/></g><defs><filter id="light-blur" x="0" y="0" width="600" height="600" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB"><feGaussianBlur stdDeviation="100"/></filter></defs></svg>`;
---

<div class:list={['lights', cls]} style={`--light-size:${size}px;--light-top:${top}px;--light-offset:${offset}px`} aria-hidden="true">
  <div class="light light--left" set:html={svg} />
  <div class="light light--right" set:html={svg} />
</div>

<style>
  .lights {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    /* Плями вищі за секцію обрізаються її нижнім краєм — без маски на стику з наступною секцією видно шов. */
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 240px), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - 240px), transparent);
  }
  .light {
    position: absolute;
    top: var(--light-top);
    width: var(--light-size);
    height: var(--light-size);
    opacity: 0.5;
  }
  .light--left {
    left: calc(var(--light-offset) * -1);
  }
  .light--right {
    right: calc(var(--light-offset) * -1);
  }
</style>

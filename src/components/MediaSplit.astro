---
/**
 * Секція «фото + список з галочками».
 *  variant="layout"  — Framer «Layout» (Стерилізація): фото 630×560, колонка 630 зі списком 522 (відступ 108 з боку фото).
 *  variant="benefit" — Framer «benefit-1» (Про нас): фото 576×512, список 576, між ними простір.
 * Tablet/Phone: колонка, фото завжди зверху.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CheckList from './CheckList.astro';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  imagePosition?: 'left' | 'right';
  items: { title: string; text: string }[];
  variant?: 'layout' | 'benefit';
}
const { image, imageAlt, imagePosition = 'left', items, variant = 'layout' } = Astro.props;
---

<div class:list={['media-split', `media-split--${variant}`, `media-split--image-${imagePosition}`]}>
  <div class="pic">
    <Image src={image} alt={imageAlt} widths={[358, 630, 960, 1260]} sizes="(max-width: 1199.98px) 100vw, 630px" format="webp" />
  </div>
  <div class="list">
    <CheckList items={items} />
  </div>
</div>

<style>
  .media-split {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 20px;
    width: 100%;
  }
  .media-split--image-right .pic {
    order: 2;
  }
  .pic {
    flex: none;
    overflow: hidden;
    border-radius: 80px;
  }
  .pic :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .media-split--layout .pic {
    width: 630px;
    height: 560px;
  }
  .media-split--layout .list {
    width: 630px;
    display: flex;
  }
  .media-split--layout.media-split--image-left .list {
    padding-left: 108px;
  }
  .media-split--layout.media-split--image-right .list {
    padding-right: 108px;
  }
  .media-split--benefit {
    justify-content: space-between;
  }
  .media-split--benefit .pic {
    width: 576px;
    height: 512px;
  }
  .media-split--benefit .list {
    width: 576px;
  }

  @media (max-width: 1199.98px) {
    .media-split {
      flex-direction: column;
      align-items: stretch;
      gap: 40px;
    }
    .media-split--image-right .pic {
      order: 0;
    }
    .media-split .pic {
      width: 100%;
      height: auto;
      aspect-ratio: 630 / 560;
      border-radius: 60px;
    }
    .media-split .list {
      width: 100%;
      padding: 0 !important;
    }
  }
  @media (max-width: 809.98px) {
    .media-split {
      gap: 20px;
    }
    .media-split .pic {
      border-radius: 40px;
    }
  }
</style>

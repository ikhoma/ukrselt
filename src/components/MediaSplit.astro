---
/**
 * Секція «фото + список з галочками».
 *  variant="layout"  — Framer «Layout» (Стерилізація, головна), variant="benefit" — Framer «benefit-1» (Про нас).
 *  У Framer були різні фіксовані ширини (630+108 / 576 з простором); з 06.11 обидва на сітці: фото 6 колонок,
 *  список 5 колонок через одну від фото (рішення Івана). Варіант лишено як мітку.
 * Tablet/Phone: колонка, фото завжди зверху.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CheckList from './CheckList.astro';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  imagePosition?: 'left' | 'right';
  items: { title: string; text: string }[];
  variant?: 'layout' | 'benefit';
}
const { image, imageAlt, imagePosition = 'left', items, variant = 'layout' } = Astro.props;
---

<div class:list={['media-split', `media-split--${variant}`, `media-split--image-${imagePosition}`]}>
  <div class="pic">
    <Image src={image} alt={imageAlt} widths={[358, 630, 960, 1260]} sizes="(max-width: 1199.98px) 100vw, 50vw" format="webp" />
  </div>
  <div class="list">
    <CheckList items={items} />
  </div>
</div>

<style>
  /* Сітка 12 колонок (рішення Івана 06.11): фото — 6 колонок, список — 5 колонок через одну від фото
     (фото ліворуч: 1–6 і 8–12; праворуч: 7–12 і 1–5). Обидва варіанти однакові; пропорція фото 630:560 з Framer. */
  .media-split {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    align-items: center;
    width: 100%;
    container-type: inline-size;
  }
  .pic {
    grid-row: 1;
    grid-column: 1 / span 6;
    aspect-ratio: 630 / 560;
    overflow: hidden;
    border-radius: 80px;
  }
  .list {
    grid-row: 1;
    grid-column: 8 / span 5;
    display: flex;
  }
  .media-split--image-right .pic {
    grid-column: 7 / span 6;
  }
  .media-split--image-right .list {
    grid-column: 1 / span 5;
  }
  .pic :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 1199.98px) {
    .media-split {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 40px;
    }
    .media-split .pic {
      width: 100%;
      border-radius: 60px;
    }
    .media-split .list {
      width: 100%;
    }
  }
  @media (max-width: 809.98px) {
    .media-split {
      gap: 20px;
    }
    .media-split .pic {
      border-radius: 40px;
    }
  }
</style>

---
/**
 * Hero сторінки з фото (Framer: Paralax на «Про нас», Hero на «Стерилізації»).
 * Висота 70vh (мін. — текст + відступ), H1 на 200 px / 160 px як на інших сторінках (рішення Івана 31.10); фото cover, паралакс, оверлей rgba(51,51,51,0.5).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  text: string;
  image: ImageMetadata;
  imageAlt: string;
  /** Зсув фото -90px також на Tablet (у Framer так на «Стерилізації», на «Про нас» — ні). */
  tabletOffset?: boolean;
}
const { title, text, image, imageAlt, tabletOffset = false } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--tablet-offset': tabletOffset }]}>
  <Image class="image" data-parallax="0.1" src={image} alt={imageAlt} widths={[768, 1440, 2048]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" />
  <div class="overlay"></div>
  <div class="title">
    <h1 class="text-heading-1">{title}</h1>
    <p class="text">{text}</p>
  </div>
</section>

<style>
  /*
   * Рішення Івана 31.10 (відхід від Framer, де Hero 720/900 px з відступом 48 і заголовком по центру):
   *  - Hero починається з верху сторінки під TopBar (як на головній) — без margin-top, який «протікав» і давав чорну смугу;
   *  - H1 на тій самій висоті, що й на сторінках без фото (200 px, на телефоні 160 px), щоб заголовок не стрибав між сторінками;
   *  - висота 70% вікна, але не менша за текст + відступ знизу.
   */
  .page-hero {
    position: relative;
    min-height: 70vh;
    padding: 200px 80px 120px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-almost-black);
  }
  .image {
    position: absolute;
    top: -90px;
    left: 0;
    width: 100%;
    height: calc(100% + 180px);
    object-fit: cover;
  }
  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(51, 51, 51, 0.5);
  }
  .title {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    width: 100%;
    text-align: center;
  }
  /* 6 центральних колонок сітки (06.11): на 1440 це ті самі 630 з Framer. */
  .text {
    width: calc((100% - (var(--grid-cols) - 1) * var(--grid-gutter)) / var(--grid-cols) * 6 + 5 * var(--grid-gutter));
    max-width: 100%;
    font-size: var(--text-body-size);
    line-height: var(--text-body-line-height);
    color: var(--color-clean-white);
  }
  @media (max-width: 1439.98px) {
    .page-hero {
      padding-left: 32px;
      padding-right: 32px;
    }
  }
  @media (max-width: 1199.98px) {
    .page-hero:not(.page-hero--tablet-offset) .image {
      top: 0;
      height: 100%;
    }
  }
  @media (max-width: 809.98px) {
    .page-hero {
      padding: 160px 16px 80px;
    }
    .page-hero .image {
      top: 0;
      height: 100%;
    }
  }
</style>

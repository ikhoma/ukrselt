---
/**
 * Hero сторінки з фото (Framer: Paralax на «Про нас», Hero на «Стерилізації»).
 * 720px (Desktop/Tablet), 900px (Phone); фото cover з відступом -90px (паралакс — етап 6), оверлей rgba(51,51,51,0.5).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  text: string;
  image: ImageMetadata;
  imageAlt: string;
  /** Зсув фото -90px також на Tablet (у Framer так на «Стерилізації», на «Про нас» — ні). */
  tabletOffset?: boolean;
}
const { title, text, image, imageAlt, tabletOffset = false } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--tablet-offset': tabletOffset }]}>
  <Image class="image" data-parallax="0.1" src={image} alt={imageAlt} widths={[768, 1440, 2048]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" />
  <div class="overlay"></div>
  <div class="title">
    <h1 class="text-heading-1">{title}</h1>
    <p class="text">{text}</p>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    height: 720px;
    margin-top: 48px; /* під TopBar, як у Framer */
    overflow: hidden;
    background: var(--color-almost-black);
  }
  .image {
    position: absolute;
    top: -90px;
    left: 0;
    width: 100%;
    height: 900px;
    object-fit: cover;
  }
  .overlay {
    position: absolute;
    inset: 0;
    background: rgba(51, 51, 51, 0.5);
  }
  .title {
    position: absolute;
    top: 360px;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    width: 100%;
    text-align: center;
  }
  .text {
    width: 630px;
    max-width: 100%;
    font-size: var(--text-body-size);
    line-height: var(--text-body-line-height);
    color: var(--color-clean-white);
  }
  @media (max-width: 1199.98px) {
    .page-hero:not(.page-hero--tablet-offset) .image {
      top: 0;
      height: 100%;
    }
  }
  @media (max-width: 809.98px) {
    .page-hero .image {
      top: 0;
      height: 100%;
    }
  }
  @media (max-width: 809.98px) {
    .page-hero {
      height: 900px;
    }
    .title {
      top: 450px;
      padding: 0 15px;
    }
  }
</style>

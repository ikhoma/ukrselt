---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  illustrated?: boolean;
  description?: string;
  photos: [ImageMetadata, ImageMetadata];
}
const { photos, illustrated = false, description } = Astro.props;
const labels = ['До', 'Після'];
const portrait = photos.every((photo) => photo.height > photo.width);
---

<figure class="comparison">
  <div class="labels text-heading-4" aria-hidden="true">
    {labels.map((label) => <span>{label}</span>)}
  </div>
  <div class:list={['photos', { 'photos--portrait': portrait }]}>
    {photos.map((photo, index) => (
      <Image
        src={photo}
        alt={labels[index]}
        widths={[360, 640, 1000]}
        sizes="(max-width: 809.98px) calc((100vw - 48px) / 2), 25vw"
        format="webp"
      />
    ))}
  </div>
  {(description || illustrated) && (
    <figcaption class="text-body">
      {description ?? 'Згенерована ілюстрація для макета'}
    </figcaption>
  )}
</figure>

<style>
  .labels,
  .photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gutter);
  }
  .labels {
    margin-bottom: 8px;
  }
  .photos img {
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    object-position: center 42%;
    border-radius: 32px;
  }
  .photos--portrait img {
    aspect-ratio: 7 / 10;
    object-fit: contain;
    background: var(--color-almost-black);
  }
  figcaption {
    margin-top: 20px;
  }

  @media (max-width: 809.98px) {
    .photos img {
      border-radius: 24px;
    }
  }
</style>

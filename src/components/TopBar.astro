---
/**
 * Верхня смуга з контактами (у Framer: «Desktop/Tablet/Phone Animation» → Info Stack).
 * Desktop: 3 телефони + адреса; Tablet: 2 телефони + адреса; Phone: 1 телефон. Завжди — вибір мови.
 */
import LocaleSelector from './LocaleSelector.astro';
import { phones, address } from '../data/site';

interface Props {
  /** Лінія знизу (у Framer на всіх сторінках, крім головної, де TopBar лежить на Hero). */
  divider?: boolean;
}
const { divider = true } = Astro.props;
---

<div class:list={['top-bar', { 'top-bar--divider': divider }]}>
  <div class="info-stack">
    {
      phones.map((p, i) => (
        <a class:list={['item', `phone-${i + 1}`]} href={p.href}>
          {p.label}
        </a>
      ))
    }
    <a class="item address" href={address.href}>
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path stroke="currentColor" d="M21 10C21 17 12 23 12 23C12 23 3 17 3 10C3 7.61305 3.94821 5.32387 5.63604 3.63604C7.32387 1.94821 9.61305 1 12 1C14.3869 1 16.6761 1.94821 18.364 3.63604C20.0518 5.32387 21 7.61305 21 10Z" stroke-width="2"></path><path stroke="currentColor" d="M12 13C13.6569 13 15 11.6569 15 10C15 8.34315 13.6569 7 12 7C10.3431 7 9 8.34315 9 10C9 11.6569 10.3431 13 12 13Z" stroke-width="2" stroke-linejoin="round"></path></svg>
      <span>{address.label}</span>
    </a>
    <LocaleSelector />
  </div>
</div>

<style>
  .top-bar {
    height: 48px;
    padding: 0 80px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    background: var(--color-almost-black);
  }
  .top-bar--divider {
    position: relative;
  }
  .top-bar--divider::after {
    content: '';
    position: absolute;
    inset: 0;
    border-bottom: 1px solid rgba(254, 254, 254, 0.1);
    pointer-events: none;
  }
  .info-stack {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .item {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-family);
    font-size: var(--text-body-3-size);
    line-height: var(--text-body-3-line-height);
    color: var(--color-somewhat-light-grey);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-hover) var(--ease-hover);
  }
  .item:hover {
    color: var(--color-greyish);
  }
  .address svg {
    color: var(--color-greyish);
    flex: none;
  }

  /* Бічні відступи — як у рядка меню на кожній ширині (80 / 32 / 15), щоб контакти й логотип стояли по одній сітці. */
  @media (max-width: 1439.98px) {
    .top-bar {
      padding: 0 32px;
    }
  }
  @media (max-width: 1199.98px) {
    .phone-3 {
      display: none;
    }
  }
  @media (max-width: 809.98px) {
    .top-bar {
      padding: 0 15px;
    }
    .phone-2,
    .address {
      display: none;
    }
  }
</style>

---
/**
 * Базовий шаблон сторінки: <head>, SEO, Schema.org.
 * SPEC §6. GTM і Hotjar додаються на етапі 5 (ADR-0007).
 */
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';
import { locales, defaultLocale, localeHtmlLang } from '../i18n/config';
import { getLocale } from '../i18n';
import { transitionCssVars } from '../scripts/animations';

interface Props {
  title: string;
  description: string;
  /** Для службових сторінок (404, тимчасові). */
  noindex?: boolean;
  /** Без плавного скролу (404, як у Framer). */
  noSmoothScroll?: boolean;
  /** Абсолютний або відносний шлях до OG-картинки. */
  ogImage?: string;
}

const { title, description, noindex = false, ogImage = '/og.png', noSmoothScroll = false } = Astro.props;
const site = Astro.site ?? new URL('https://ukrselt.com');
const locale = getLocale(Astro.url);

// Шлях без префікса мови → для canonical і hreflang.
const pathNoLocale =
  locale === defaultLocale ? Astro.url.pathname : Astro.url.pathname.replace(new RegExp(`^/${locale}`), '') || '/';
const localized = (l: string) => (l === defaultLocale ? pathNoLocale : `/${l}${pathNoLocale === '/' ? '' : pathNoLocale}`);
const canonical = new URL(localized(locale), site).href;
const ogImageUrl = new URL(ogImage, site).href;

// Schema.org Dentist — дані зі сторінки /contacts (SPEC §6.2).
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: 'Ukrselt',
  url: 'https://ukrselt.com/',
  image: ogImageUrl,
  email: 'info@ukrselt.com',
  telephone: ['+380630763022', '+380949062388', '+380443377388'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Велика Васильківська, 134',
    addressLocality: 'Київ',
    addressCountry: 'UA',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '21:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday', 'Sunday'],
      opens: '09:00',
      closes: '15:30',
    },
  ],
  sameAs: ['https://www.instagram.com/dental.ukrselt/', 'https://www.facebook.com/profile.php?id=100086790133405'],
};
---

<!doctype html>
<html lang={localeHtmlLang[locale]} style={transitionCssVars()} data-no-smooth-scroll={noSmoothScroll || undefined}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Чи людина сама рухала сторінку — з першого байта HTML, а не з моменту завантаження модуля анімацій (motion.ts).
      ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach(function (e) {
        addEventListener(e, function () { window.__userMoved = true; }, { once: true, passive: true });
      });
    </script>
    <meta name="viewport" content="width=device-width" />
    <meta name="format-detection" content="telephone=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex' : 'max-image-preview:large'} />

    {
      locales.length > 1 &&
        locales.map((l) => <link rel="alternate" hreflang={localeHtmlLang[l]} href={new URL(localized(l), site).href} />)
    }
    {locales.length > 1 && <link rel="alternate" hreflang="x-default" href={new URL(localized(defaultLocale), site).href} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <slot name="head" />
    <Analytics part="head" />
  </head>
  <body>
    <Analytics part="body" />
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

---
/**
 * Каркас сторінки: TopBar + main-navigation, контент, футер з ефектом reveal (SPEC §4.7).
 * Контент лежить вище за футер (z-index) і має непрозорий фон; футер — sticky bottom: 0.
 */
import BaseLayout from './BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import MainNavigation from '../components/MainNavigation.astro';
import Footer from '../components/Footer.astro';
import BookingOverlay from '../components/BookingOverlay.astro';
import HeroPrefetch from '../components/HeroPrefetch.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Лінія під TopBar (на головній немає). */
  topBarDivider?: boolean;
  /** Оверлей «Записатися» у демо-режимі (прототипи сторінок). */
  bookingDemo?: boolean;
}
const props = Astro.props;
---

<BaseLayout {...props}>
  <slot name="preloader" />
  <div class="page">
    <header class="site-header">
      <TopBar divider={Astro.props.topBarDivider ?? true} />
      <MainNavigation />
    </header>
    <main id="main">
      <slot />
    </main>
  </div>
  <Footer />
  <BookingOverlay demo={Astro.props.bookingDemo} />
  <HeroPrefetch />
</BaseLayout>

<style>
  .page {
    position: relative;
    z-index: 1;
    background: var(--color-night-black);
  }
  /* У Framer шапка лежить поверх першої секції: Intro починається з 0, Hero — з 48px (під TopBar). */
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
  }
</style>

---
/**
 * Головна (Framer «/»): Hero → Services → Benefits 1 → Benefits 2 → Testimonials → Team → Visit us → booking.
 * Прелоадер і анімації появи — етап 6.
 */
import PageLayout from '../layouts/PageLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import Preloader from '../components/Preloader.astro';
import BookingOverlay from '../components/BookingOverlay.astro';
import HomeShowcase from '../components/HomeShowcase.astro';
import MediaSplit from '../components/MediaSplit.astro';
import Lights from '../components/Lights.astro';
import Testimonials from '../components/Testimonials.astro';
import VisitUs from '../components/VisitUs.astro';
import Booking from '../components/Booking.astro';
import { getLocale, localizePath } from '../i18n';
import { getPage } from '../content/pages';
import { homeImage } from '../content/images';
import { getTeam } from '../content/collections';

const locale = getLocale(Astro.url);
const c = getPage(locale, 'home');
const team = (await getTeam(locale)).filter((p) => p.data.homePhoto).slice(0, 6); // 6 позицій у анімації Team (motion.ts)
---

<PageLayout title={c.seo.title} description={c.seo.description} topBarDivider={false}>
  <Preloader slot="preloader" />
  <HomeHero title={c.hero.title} words={c.hero.words} h1={c.hero.h1} text={c.hero.text} cta={c.hero.cta} />

  <HomeShowcase
    variant="services"
    title={c.services.title}
    accent={c.services.accent}
    text={c.services.text}
    cta={c.services.cta}
    href={localizePath('/services', locale)}
    cards={c.services.cards.map((k: { image: string; alt: string }) => ({ image: homeImage(k.image), alt: k.alt }))}
  />

  <section class="benefits benefits--1">
    <Lights size={900} offset={400} />
    <MediaSplit variant="layout" image={homeImage(c.benefits1.image)} imageAlt={c.benefits1.imageAlt} imagePosition="right" items={c.benefits1.items} />
  </section>
  <section class="benefits">
    <Lights size={900} offset={400} />
    <MediaSplit variant="layout" image={homeImage(c.benefits2.image)} imageAlt={c.benefits2.imageAlt} imagePosition="left" items={c.benefits2.items} />
  </section>

  <Testimonials {...c.testimonials} />

  <HomeShowcase
    variant="team"
    title={c.team.title}
    accent={c.team.accent}
    text={c.team.text}
    cta={c.team.cta}
    href={localizePath('/team', locale)}
    cards={team.map((p) => ({ image: p.data.homePhoto!, alt: p.data.photoAlt, position: p.data.homePhotoPosition }))}
  />

  <VisitUs />
  <Booking service="home" />
  <BookingOverlay kind="callback" />
</PageLayout>

<style>
  .benefits {
    position: relative;
    display: flex;
    justify-content: center;
    padding: 80px;
    background: var(--color-almost-black);
  }
  @media (max-width: 1439.98px) {
    .benefits {
      padding: 80px 32px;
    }
  }
  @media (max-width: 809.98px) {
    .benefits {
      padding: 40px 16px 80px;
    }
  }
</style>

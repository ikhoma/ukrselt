---
/**
 * Головна (Framer «/»): Hero → Services → Benefits 1 → Benefits 2 → Testimonials → Team → Visit us → booking.
 * Експеримент (05.11, рішення Івана): Team одразу після Services — лікарі в перших ~40% сторінки.
 * Прелоадер і анімації появи — етап 6.
 */
import PageLayout from '../layouts/PageLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import Preloader from '../components/Preloader.astro';
import ButtonCta from '../components/ButtonCta.astro';
import BookingOverlay from '../components/BookingOverlay.astro';
import HomeShowcase from '../components/HomeShowcase.astro';
import HomeServices from '../components/HomeServices.astro';
import MediaSplit from '../components/MediaSplit.astro';
import Lights from '../components/Lights.astro';
import Testimonials from '../components/Testimonials.astro';
import VisitUs from '../components/VisitUs.astro';
import Booking from '../components/Booking.astro';
import { getLocale, localizePath, useTranslations } from '../i18n';
import { getPage } from '../content/pages';
import { homeImage } from '../content/images';
import { getTeam, getServices, entrySlug } from '../content/collections';

const locale = getLocale(Astro.url);
const c = getPage(locale, 'home');
const services = await getServices(locale);
const t = useTranslations(locale);
const team = (await getTeam(locale)).filter((p) => p.data.homePhoto).slice(0, 6); // 6 позицій у анімації Team (motion.ts)
---

<PageLayout title={c.seo.title} description={c.seo.description} topBarDivider={false}>
  <Preloader slot="preloader" />
  <HomeHero title={c.hero.title} words={c.hero.words} h1={c.hero.h1} text={c.hero.text} cta={c.hero.cta} />

  {/* Експеримент (05.11): стрічка напрямів замість анімації карток. Старий блок — нижче в коментарі для порівняння. */}
  <HomeServices
    text={c.services.text}
    cta={c.services.cta}
    href={localizePath('/services', locale)}
    bigTitle={t('nav.services')}
    items={services.map((s) => ({ title: s.data.title, image: s.data.image, alt: s.data.imageAlt, href: localizePath('/services', locale) + '#' + entrySlug(s.id) }))}
  />
  {/*
  <HomeShowcase
    variant="services"
    title={c.services.title}
    accent={c.services.accent}
    text={c.services.text}
    cta={c.services.cta}
    href={localizePath('/services', locale)}
    cards={c.services.cards.map((k: { image: string; alt: string }) => ({ image: homeImage(k.image), alt: k.alt }))}
  />
  */}

  <HomeShowcase
    variant="team"
    title={c.team.title}
    accent={c.team.accent}
    text={c.team.text}
    cta={c.team.cta}
    href={localizePath('/team', locale)}
    cards={team.map((p) => ({ image: p.data.homePhoto!, alt: p.data.photoAlt, position: p.data.photoPosition }))}
  />

  <section class="benefits benefits--1">
    <Lights size={900} offset={400} />
    <MediaSplit variant="layout" image={homeImage(c.benefits1.image)} imageAlt={c.benefits1.imageAlt} imagePosition="right" items={c.benefits1.items} />
  </section>
  <section class="benefits">
    <Lights size={900} offset={400} />
    <MediaSplit variant="layout" image={homeImage(c.benefits2.image)} imageAlt={c.benefits2.imageAlt} imagePosition="left" items={c.benefits2.items} />
  </section>

  <Testimonials {...c.testimonials} />



  <VisitUs />
  <Booking service="home" />
  <BookingOverlay kind="callback" />
  <ButtonCta
    class="floating-callback"
    href={localizePath('/', locale) + '#book'}
    action="callback"
    aria-label={c.hero.cta}
    data-floating-callback
  >
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 18 18 0 0 1-7.9-2.8 18 18 0 0 1-5.5-5.5 18 18 0 0 1-2.8-8A2 2 0 0 1 5.6 3h3a2 2 0 0 1 2 1.7l.5 2.8a2 2 0 0 1-.6 2.1l-1.2 1.2a14 14 0 0 0 5.5 5.5l1.2-1.2a2 2 0 0 1 2.1-.6l2.8.5a2 2 0 0 1 1.1 1.9Z" />
    </svg>
  </ButtonCta>
</PageLayout>

<script>
  const heroCallback = document.querySelector('[data-hero-callback]');
  const floatingCallback = document.querySelector('[data-floating-callback]');

  if (heroCallback && floatingCallback) {
    const observer = new IntersectionObserver(([entry]) => {
      floatingCallback.toggleAttribute(
        'data-visible',
        !entry.isIntersecting && entry.boundingClientRect.bottom <= 0,
      );
    });
    observer.observe(heroCallback);
  }
</script>

<style>
  :global(a.floating-callback) {
    position: fixed;
    z-index: 5;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    width: 64px;
    height: 64px;
    padding: 0;
    border-radius: 50%;
    visibility: hidden;
    opacity: 0;
    transition: opacity 180ms ease, visibility 180ms, background-color var(--dur-hover) var(--ease-hover);
  }
  :global(a.floating-callback[data-visible]) {
    visibility: visible;
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(a.floating-callback) {
      transition: none;
    }
  }
  .benefits {
    position: relative;
    display: flex;
    justify-content: center;
    padding: 80px;
    background: var(--color-almost-black);
  }
  @media (max-width: 1439.98px) {
    .benefits {
      padding: 80px 32px;
    }
  }
  @media (max-width: 809.98px) {
    .benefits {
      padding: 40px 16px 80px;
    }
  }
</style>

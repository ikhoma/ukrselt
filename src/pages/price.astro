---
import PageLayout from '../layouts/PageLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import Lights from '../components/Lights.astro';
import Booking from '../components/Booking.astro';
import BookingOverlay from '../components/BookingOverlay.astro';
import { getLocale } from '../i18n';
import uk from '../content/price/uk.json';

// price-list / price-row (Framer). Дані: src/content/price/<locale>.json.
// Категорії, пошук і зміст — гілка feature/price-categories (рішення Івана 02.11, SPEC §12).
const price: Record<string, typeof uk> = { uk };
const c = price[getLocale(Astro.url)] ?? uk;
const seeAlso = c.seeAlso as Record<string, { href: string; label: string } | undefined>;

/** Рядок для пошуку: назва + синоніми + підгрупа (назву категорії не беремо: «вінір» знаходив би всю категорію). Нормалізація — та сама, що в скрипті. */
const norm = (s: string) =>
  s
    .toLowerCase()
    .replace(/['’ʼ`]/g, '')
    .replace(/[^\p{L}\p{N}]+/gu, ' ')
    .trim();
---

<PageLayout title={c.seo.title} description={c.seo.description}>
  <section class="intro">
    <Lights size={400} top={61} offset={-360} class="intro-lights" />
    <PageTitle title={c.title} text={c.intro} />
  </section>
  <section class="list" data-price>
    <div class="tools">
      <label class="search">
        <span class="sr-only">{c.search.label}</span>
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
        <input type="search" placeholder={c.search.placeholder} autocomplete="off" enterkeyhint="search" data-price-search />
        <button type="button" class="clear" aria-label={c.search.clear} data-price-clear hidden><span></span><span></span></button>
      </label>
      <p class="count" aria-live="polite" data-price-count data-template={c.search.found}></p>
    </div>
    <nav class="toc" aria-label={c.search.toc} data-price-toc>
      {c.categories.map((cat) => <a href={`#${cat.id}`}>{cat.title}</a>)}
    </nav>
    {
      c.categories.map((cat) => (
        <section class="cat" id={cat.id} data-price-cat>
          <h2 class="cat-title">{cat.title}</h2>
          {cat.groups.map((g) => (
            <div class="group" id={g.id} data-price-group>
              {g.title && <h3 class="group-title">{g.title}</h3>}
              <ul class="price-list">
                {g.items.map((it, i) => (
                  <li
                    class:list={['price-row', i % 2 === 0 ? 'odd' : 'even']}
                    data-search={norm([it.service, (it as { keywords?: string }).keywords ?? '', g.title ?? ''].join(' '))}
                  >
                    <span class="service">
                      <span class="row-cat">{cat.title}</span>
                      {it.service}
                    </span>
                    <span class="price">{it.price}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          {seeAlso[cat.id] && (
            <a class="see-also" href={seeAlso[cat.id]!.href}>
              {seeAlso[cat.id]!.label} <span aria-hidden="true">→</span>
            </a>
          )}
        </section>
      ))
    }
    <div class="empty" data-price-empty hidden>
      <p>{c.search.empty}</p>
      <button type="button" class="empty-cta" data-open-callback>{c.search.emptyCta}</button>
    </div>
  </section>
  <Booking service="price" />
  <BookingOverlay kind="callback" />
</PageLayout>

<script>
  // Пошук по прайсу: усі рядки є в HTML (SEO), скрипт лише ховає зайві.
  // Кожне слово запиту має знайтися в рядку; закінчення слів відкидаються (чистка/чистку, зуби/зуба).
  const root = document.querySelector<HTMLElement>('[data-price]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('[data-price-search]')!;
    const clear = root.querySelector<HTMLButtonElement>('[data-price-clear]')!;
    const count = root.querySelector<HTMLElement>('[data-price-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-price-empty]')!;
    const rows = [...root.querySelectorAll<HTMLElement>('.price-row')];
    const groups = [...root.querySelectorAll<HTMLElement>('[data-price-group]')];
    const cats = [...root.querySelectorAll<HTMLElement>('[data-price-cat]')];

    const norm = (s: string) =>
      s
        .toLowerCase()
        .replace(/['’ʼ`]/g, '')
        .replace(/[^\p{L}\p{N}]+/gu, ' ')
        .trim();
    const stem = (w: string) => (w.length >= 4 ? w.slice(0, Math.max(3, w.length - 2)) : w);
    const stripe = (list: HTMLElement[]) =>
      list.forEach((r, i) => {
        r.classList.toggle('odd', i % 2 === 0);
        r.classList.toggle('even', i % 2 === 1);
      });

    const apply = () => {
      const terms = norm(input.value).split(' ').filter(Boolean).map(stem);
      const searching = terms.length > 0;
      root.classList.toggle('is-searching', searching);
      clear.hidden = !input.value;
      if (!searching) {
        rows.forEach((r) => (r.hidden = false));
        groups.forEach((g) => (g.hidden = false));
        cats.forEach((c) => (c.hidden = false));
        groups.forEach((g) => stripe([...g.querySelectorAll<HTMLElement>('.price-row')]));
        count.textContent = '';
        empty.hidden = true;
        return;
      }
      const shown: HTMLElement[] = [];
      rows.forEach((r) => {
        const hay = r.dataset.search!;
        const ok = terms.every((t) => hay.includes(t));
        r.hidden = !ok;
        if (ok) shown.push(r);
      });
      groups.forEach((g) => (g.hidden = !g.querySelector('.price-row:not([hidden])')));
      cats.forEach((c) => (c.hidden = !c.querySelector('[data-price-group]:not([hidden])')));
      stripe(shown);
      count.textContent = shown.length ? count.dataset.template!.replace('{n}', String(shown.length)) : '';
      empty.hidden = shown.length > 0;
    };

    input.addEventListener('input', apply);
    clear.addEventListener('click', () => {
      input.value = '';
      apply();
      input.focus();
    });
    // Перехід зі змісту під час пошуку: скинути пошук, щоб категорія була видима.
    root.querySelectorAll('[data-price-toc] a').forEach((a) =>
      a.addEventListener('click', () => {
        if (input.value) {
          input.value = '';
          apply();
        }
      }, { capture: true }),
    );
    // Відновлення значення поля браузером (назад/вперед).
    if (input.value) apply();
  }
</script>

<style>
  .intro {
    position: relative;
    padding: 200px 80px 80px;
    background: var(--color-almost-black);
  }
  .list {
    padding: 49px 80px 80px;
    background: var(--color-almost-black);
  }

  /* ── Пошук і зміст (нові елементи, у Framer їх немає; стилі з поля форми і btn/secondary — на погодження) ── */
  .tools {
    display: none; /* без JS пошук не працює — не показуємо */
  }
  :global(html.js) .tools {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 24px;
  }
  .search {
    position: relative;
    flex: 0 1 560px;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 56px;
    padding: 0 20px;
    border-radius: 20px;
    background-image: linear-gradient(rgb(54, 54, 55) 0%, rgb(50, 50, 51) 100%);
    box-shadow: 0 10px 30px 0 rgba(31, 31, 31, 0.1);
    color: var(--color-somewhat-light-grey);
  }
  .search::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: inherit;
    pointer-events: none;
  }
  .search:focus-within::after {
    border-color: rgba(255, 255, 255, 0.2);
  }
  .search svg {
    flex: none;
  }
  .search input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    outline: none;
    background: none;
    font-family: var(--font-family);
    font-size: 16px;
    line-height: 20px;
    color: var(--color-clean-white);
    -webkit-appearance: none;
    appearance: none;
  }
  .search input::-webkit-search-cancel-button {
    display: none;
  }
  .search input::placeholder {
    color: var(--color-somewhat-light-grey);
    opacity: 1;
  }
  .clear {
    position: relative;
    z-index: 1;
    flex: none;
    width: 32px;
    height: 32px;
    margin-right: -8px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .clear span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 1.5px;
    background: var(--color-somewhat-light-grey);
    transform: translate(-50%, -50%) rotate(45deg);
    transition: background-color var(--dur-hover) var(--ease-hover);
  }
  .clear span + span {
    transform: translate(-50%, -50%) rotate(-45deg);
  }
  .clear:hover span {
    background: var(--color-clean-white);
  }
  .count {
    margin: 0;
    font-size: var(--text-body-size);
    line-height: var(--text-body-line-height);
    color: var(--text-body-color);
  }
  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }
  .toc a {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 20px;
    border-radius: 48px;
    font-size: 16px;
    line-height: 16px;
    color: var(--color-clean-white);
    text-decoration: none;
    white-space: nowrap;
  }
  .toc a::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgba(253, 253, 254, 0.5);
    border-radius: inherit;
    pointer-events: none;
    transition: border-color var(--dur-hover-outline) var(--ease-hover-outline);
  }
  .toc a:hover::after,
  .toc a:focus-visible::after {
    border-color: rgb(253, 253, 254);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ── Категорії ── */
  .cat {
    padding-top: 80px;
  }
  .cat-title {
    margin: 0 0 24px;
    padding: 0 32px;
    font-size: var(--text-heading-3-size);
    line-height: var(--text-heading-3-line-height);
    letter-spacing: var(--text-heading-3-letter-spacing);
    font-weight: var(--text-heading-3-weight);
    color: var(--text-heading-3-color);
  }
  .group + .group {
    margin-top: 40px;
  }
  .group-title {
    margin: 0 0 16px;
    padding: 0 32px;
    font-size: var(--text-heading-4-size);
    line-height: var(--text-heading-4-line-height);
    font-weight: var(--text-heading-4-weight);
    color: var(--color-light-grey);
  }
  .see-also {
    display: inline-flex;
    gap: 8px;
    margin: 24px 32px 0;
    font-size: var(--text-body-size);
    line-height: var(--text-body-line-height);
    color: var(--color-lighter-blue);
    text-decoration: none;
  }
  .see-also:hover {
    text-decoration: underline;
  }
  .row-cat {
    display: none;
  }

  /* Під час пошуку — один список: заголовки ховаються, біля кожної послуги підпис категорії. */
  .is-searching .cat {
    padding-top: 0;
  }
  .is-searching .cat-title,
  .is-searching .group-title,
  .is-searching .see-also {
    display: none;
  }
  .is-searching .group + .group {
    margin-top: 0;
  }
  .is-searching .row-cat {
    display: block;
    margin-bottom: 8px;
    font-size: var(--text-body-3-size);
    line-height: 1.3;
    color: var(--color-somewhat-light-grey);
    opacity: 0.7;
  }
  [hidden] {
    display: none !important;
  }

  .empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding: 32px;
    border-radius: 32px;
    background: var(--color-dark-grey);
  }
  .empty p {
    margin: 0;
    font-size: var(--text-body-2-size);
    line-height: 28px;
    letter-spacing: var(--text-body-2-letter-spacing);
    color: var(--text-body-2-color);
  }
  .empty-cta {
    height: 70px;
    padding: 24px 32px;
    border: 0;
    border-radius: 40px;
    background: var(--color-ukrselt-blue);
    color: var(--color-clean-white);
    font-family: var(--font-family);
    font-size: 16px;
    line-height: 22.4px;
    cursor: pointer;
    transition: background-color var(--dur-hover) var(--ease-hover);
  }
  .empty-cta:hover {
    background: var(--color-lighter-blue);
  }

  /* ── Рядок прайсу (Framer price-row) ── */
  .price-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .price-row {
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 32px;
    border-radius: 32px;
  }
  .price-row.odd {
    background: var(--color-dark-grey);
  }
  .service {
    flex: 1;
    font-size: var(--text-body-2-size);
    line-height: 28px;
    letter-spacing: var(--text-body-2-letter-spacing);
    color: var(--text-body-2-color);
  }
  .price {
    flex: none;
    text-align: right;
    font-size: var(--text-heading-4-size);
    line-height: var(--text-heading-4-line-height);
    font-weight: var(--text-heading-4-weight);
    color: var(--text-heading-4-color);
    white-space: nowrap;
  }
  @media (max-width: 1439.98px) {
    .intro,
    .list {
      padding-left: 32px;
      padding-right: 32px;
    }
  }
  @media (max-width: 809.98px) {
    .intro {
      padding: 160px 16px 40px;
    }
    .list {
      padding: 46px 16px 40px;
    }
    :global(html.js) .tools {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
    .search {
      flex: none;
    }
    /* Телефон: категорії одним рядком із горизонтальним гортанням. */
    .toc {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin: 0 -16px 8px;
      padding: 0 16px;
      scrollbar-width: none;
    }
    .toc::-webkit-scrollbar {
      display: none;
    }
    .cat {
      padding-top: 48px;
    }
    .cat-title {
      padding: 0 16px;
      font-size: 24px;
    }
    .group-title,
    .see-also {
      padding: 0 16px;
      margin-left: 0;
      margin-right: 0;
      font-size: 20px;
    }
    .see-also {
      font-size: var(--text-body-size);
    }
    .empty {
      padding: 24px 16px;
    }
    .service {
      line-height: 24px;
    }
  }
</style>

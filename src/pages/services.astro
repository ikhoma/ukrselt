---
/**
 * /services (Framer): Hero → блоки напрямів з колекції services (фото чергується: праворуч / ліворуч) → booking.
 */
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import ServiceBlock from '../components/ServiceBlock.astro';
import Booking from '../components/Booking.astro';
import { getLocale, localizePath } from '../i18n';
import { getPage } from '../content/pages';
import { pageImage } from '../content/images';
import { getServices, entrySlug } from '../content/collections';
import { caries, crowns, hygiene, implantation, veneers } from '../data/service-landings';

const locale = getLocale(Astro.url);
const c = getPage(locale, 'services');
const services = await getServices(locale);
const landingLinks: Record<string, { slug: string; label: string }[]> = {
  therapy: [{ slug: caries.slug, label: 'Лікування карієсу' }],
  implantation: [{ slug: implantation.slug, label: 'Імплантація зубів' }],
  orthopedics: [
    { slug: crowns.slug, label: 'Коронки та протезування' },
    { slug: veneers.slug, label: 'Вініри' },
  ],
  hygiene: [{ slug: hygiene.slug, label: 'Професійна чистка зубів' }],
};
---

<PageLayout title={c.seo.title} description={c.seo.description}>
  <PageHero title={c.hero.title} text={c.hero.text} image={pageImage(c.hero.image)} imageAlt={c.hero.imageAlt} />
  {
    services.map((s, i) => (
      <ServiceBlock
        id={entrySlug(s.id)}
        first={i === 0}
        title={s.data.title}
        lead={s.data.lead}
        paragraphs={s.data.paragraphs}
        image={s.data.image}
        imageAlt={s.data.imageAlt}
        imagePosition={i % 2 === 0 ? 'right' : 'left'}
        links={landingLinks[entrySlug(s.id)]?.map(({ slug, label }) => ({
          href: localizePath(`/services/${slug}`, locale),
          label,
        }))}
      />
    ))
  }
  <Booking service="services" />
</PageLayout>

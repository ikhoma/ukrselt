---
/**
 * Прототип лендінгу «Лікування карієсу» — версія Claude (гілка prototype/caries-claude, 06.11).
 * Відмінність від prototype/caries-service: зібрано лише з компонентів і токенів сайту (сітка 12/8/4,
 * Heading/Body, MediaSplit, CardTeam, Testimonials, VisitUs, Booking), без окремого лейауту й стилів.
 * Вимоги — «ТЗ розробнику» маркетингу: H1 «… в Києві», перший екран (заголовок → речення → ціна «від» → форма),
 * дві форми (Ім'я + Телефон, «Записатися на діагностику»), блок ціни зі складом, лікарі, етапи, 5 питань.
 * Рішення Івана 06.11: форми демо (нічого не надсилають), лікарі Моторна + Вольська, тексти — чернетка з позначками.
 * Ціни підтягуються зі спільного прайсу (src/content/price/uk.json), не дублюються.
 * Сторінка noindex і виключена з sitemap до погодження.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Lights from '../../components/Lights.astro';
import MediaSplit from '../../components/MediaSplit.astro';
import CardTeam from '../../components/CardTeam.astro';
import BtnSecondary from '../../components/BtnSecondary.astro';
import Faq from '../../components/Faq.astro';
import DraftNote from '../../components/DraftNote.astro';
import Testimonials from '../../components/Testimonials.astro';
import VisitUs from '../../components/VisitUs.astro';
import Booking from '../../components/Booking.astro';
import { getLocale, localizePath } from '../../i18n';
import { getPage } from '../../content/pages';
import { getTeam, entrySlug } from '../../content/collections';
import price from '../../content/price/uk.json';
import stepsImage from '../../assets/services/therapy.png';

const locale = getLocale(Astro.url);
const home = getPage(locale, 'home');
const teamPage = getPage(locale, 'team');

/** Позиція прайсу за точною назвою; якщо назву в прайсі змінять — збірка впаде, а не покаже стару ціну. */
const allItems = price.categories.flatMap((c) => c.groups.flatMap((g) => g.items));
const priceOf = (service: string) => {
  const it = allItems.find((i) => i.service === service);
  if (!it) throw new Error(`Немає в прайсі: ${service}`);
  return it.price;
};
const caries = price.categories.find((c) => c.id === 'karies')!.groups.flatMap((g) => g.items);
const filling = priceOf('Накладання пломби з композитів світлового твердіння');
const fromPrice = Number(filling.split('–')[0].trim()).toLocaleString('uk-UA');
const extras = [
  'Огляд (до 10 хв)',
  'Консультація лікаря-стоматолога',
  'Цифрова дентальна діагностика',
  'Знеболення',
  'Накладання кофердаму',
  'Комплект індивідуального захисту лікарів та пацієнтів',
].map((service) => ({ service, price: priceOf(service) }));

const steps = [
  { title: 'Огляд і знімок', text: 'Лікар оглядає зуб і за потреби робить цифровий знімок, щоб побачити, наскільки глибоке ураження.' },
  { title: 'План і вартість', text: 'Пояснюємо, що потрібно зробити, і погоджуємо вартість до початку лікування.' },
  { title: 'Лікування', text: 'За потреби — знеболення та ізоляція зуба кофердамом. Лікар прибирає уражені тканини.' },
  { title: 'Пломба і перевірка прикусу', text: 'Відновлюємо зуб фотополімером з урахуванням кольору й форми, перевіряємо прикус і поліруємо.' },
];

const faq = [
  { question: 'Чи буде боляче?', answer: 'За потреби лікування проводять під місцевим знеболенням. Лікар обговорить це з вами перед початком.' },
  { question: 'Скільки візитів потрібно?', answer: 'Часто зуб відновлюють за одне відвідування. Якщо ураження глибоке і потрібне лікування каналів, візитів буде більше — лікар пояснить після огляду.' },
  { question: 'Зуб не болить — чи треба його лікувати?', answer: 'На початку карієс часто не болить. Чи потрібне лікування, визначає лікар після огляду.' },
  { question: 'Скільки служить пломба?', answer: 'Залежить від розміру пломби, матеріалу та догляду. Регулярні огляди допомагають вчасно помітити, якщо пломбу потрібно відкоригувати.' },
  { question: 'Чи можна оплатити частинами?', answer: 'Умови оплати уточнюйте в адміністратора.' },
];

const doctorSlugs = ['motorna', 'sofia'];
const team = (await getTeam(locale)).filter((p) => doctorSlugs.includes(entrySlug(p.id)));
team.sort((a, b) => doctorSlugs.indexOf(entrySlug(a.id)) - doctorSlugs.indexOf(entrySlug(b.id)));
const cardSizes = '(max-width: 809.98px) calc(100vw - 32px), (max-width: 1199.98px) calc((100vw - 84px) / 2), calc((100vw - 200px) / 3)';
const service = 'likuvannya-kariyesu';
---

<PageLayout
  title="Лікування карієсу в Києві — Ukrselt"
  description="Лікування карієсу в Ukrselt біля метро Либідська: огляд, план і вартість до початку лікування, пломби з композиту світлового твердіння. Запис на діагностику."
  noindex
  bookingDemo
>
  <section class="hero">
    <Lights size={400} top={61} offset={-360} />
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 class="text-heading-1 title">Лікування карієсу в&nbsp;Києві</h1>
        <p class="lead">З'ясуємо, що відбувається із зубом, і відновимо його фотополімером з урахуванням кольору та форми.</p>
        <div class="from">
          <p class="from-price">Пломба — від {fromPrice} грн</p>
          <p class="from-note">Композит світлового твердіння. Огляд, знімок і знеболення — окремо, якщо потрібні.</p>
        </div>
      </div>
      <div class="hero-form">
        <Booking service={service} variant="inline" submit="diagnostics" demo />
        <DraftNote text="Прототип · форми демонстраційні, нічого не надсилають" />
      </div>
    </div>
  </section>

  <section class="cost" id="cost">
    <div class="head">
      <h2 class="text-heading-2">Скільки коштує</h2>
      <p class="head-text">Ціна залежить від того, скільки тканин зуба потрібно відновити. Остаточну вартість погоджуємо після огляду, до початку лікування.</p>
    </div>
    <div class="lists">
      <div class="list">
        <h3 class="list-title">Лікування карієсу та реставрації</h3>
        <ul class="rows">
          {caries.map((it, i) => (
            <li class:list={['row', { odd: i % 2 === 0 }]}><span class="service">{it.service}</span><span class="price">{it.price}</span></li>
          ))}
        </ul>
      </div>
      <div class="list">
        <h3 class="list-title">Може знадобитися додатково</h3>
        <ul class="rows">
          {extras.map((it, i) => (
            <li class:list={['row', { odd: i % 2 === 0 }]}><span class="service">{it.service}</span><span class="price">{it.price}</span></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="cost-foot">
      <DraftNote text="Що входить у ціну пломби, а що оплачується окремо — на погодження клініки" />
      <BtnSecondary href={localizePath('/price', locale)} label="Повний прайс" />
    </div>
  </section>

  <section class="steps">
    <Lights size={900} offset={400} />
    <div class="head head--steps">
      <h2 class="text-heading-2">Як проходить лікування</h2>
      <DraftNote text="Етапи й кількість візитів — на погодження клініки" />
    </div>
    <MediaSplit variant="layout" image={stepsImage} imageAlt="Стоматолог працює з мікроскопом під час лікування зуба" imagePosition="left" items={steps} />
  </section>

  <section class="doctors">
    <div class="head">
      <h2 class="text-heading-2">Хто лікуватиме</h2>
      <p class="head-text">Лікування карієсу та естетичні реставрації — серед напрямів роботи наших лікарок.</p>
    </div>
    <div class="grid">
      {team.map((p) => (
        <CardTeam
          name={p.data.name}
          role={p.data.role}
          photo={p.data.photo}
          photoAlt={p.data.photoAlt}
          href={localizePath(`/team/${entrySlug(p.id)}`, locale)}
          moreLabel={teamPage.more}
          moreAriaLabel={`${teamPage.more}: ${p.data.name}`}
          sizes={cardSizes}
        />
      ))}
    </div>
  </section>

  <section class="questions">
    <div class="q-head">
      <h2 class="text-heading-2">Питання перед візитом</h2>
      <DraftNote text="Відповіді — чернетка на погодження клініки" />
    </div>
    <div class="q-list"><Faq items={faq} /></div>
  </section>

  <Testimonials {...home.testimonials} />
  <VisitUs />
  <Booking service={service} submit="diagnostics" demo />
</PageLayout>

<style>
  section {
    position: relative;
    padding-left: var(--grid-pad);
    padding-right: var(--grid-pad);
    background: var(--color-almost-black);
  }
  section > :not(:global(.lights)) {
    position: relative;
    z-index: 1;
  }
  .head {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    row-gap: 24px;
    align-items: end;
    margin-bottom: 56px;
  }
  .head h2 {
    grid-column: 1 / span 6;
    margin: 0;
  }
  .head-text {
    grid-column: 8 / span 5;
    margin: 0;
    font-size: var(--text-body-size);
    line-height: var(--text-body-line-height);
    color: var(--text-body-color);
  }
  .head--steps {
    align-items: center;
  }
  .head--steps :global(.draft-note) {
    grid-column: 8 / span 5;
    justify-self: start;
  }

  /* ── Перший екран: текст 1–6, форма 8–12 ── */
  .hero {
    padding-top: 200px;
    padding-bottom: 80px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    align-items: end;
  }
  .hero-copy {
    grid-column: 1 / span 6;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
  }
  .title {
    margin: 0;
  }
  .lead {
    margin: 0;
    font-size: var(--text-body-2-size);
    line-height: var(--text-body-2-line-height);
    letter-spacing: var(--text-body-2-letter-spacing);
    color: var(--text-body-2-color);
  }
  .from {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .from p {
    margin: 0;
  }
  .from-note {
    font-size: var(--text-body-size);
    line-height: var(--text-body-line-height);
    color: var(--text-body-color);
  }
  .from-price {
    font-size: var(--text-heading-3-size);
    line-height: var(--text-heading-3-line-height);
    letter-spacing: var(--text-heading-3-letter-spacing);
    font-weight: var(--text-heading-3-weight);
    color: var(--color-clean-white);
  }
  .hero-form {
    grid-column: 8 / span 5;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .hero-form > :global(.booking) {
    align-self: stretch;
  }

  /* ── Вартість: рядки як на сторінці «Ціни» ── */
  .cost {
    padding-top: 80px;
    padding-bottom: 80px;
  }
  .lists {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    row-gap: 56px;
  }
  .list:first-child {
    grid-column: 1 / span 6;
  }
  .list:last-child {
    grid-column: 7 / span 6;
  }
  .list-title {
    margin: 0 0 16px;
    padding: 0 32px;
    font-size: var(--text-heading-4-size);
    line-height: var(--text-heading-4-line-height);
    font-weight: var(--text-heading-4-weight);
    color: var(--text-heading-4-color);
  }
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .row {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 24px 32px;
    border-radius: 32px;
  }
  .row.odd {
    background: var(--color-dark-grey);
  }
  .service {
    flex: 1;
    min-width: 0;
    font-size: var(--text-body-size);
    line-height: var(--text-body-line-height);
    color: var(--color-light-grey);
  }
  .price {
    flex: none;
    font-size: var(--text-heading-4-size);
    line-height: var(--text-heading-4-line-height);
    font-weight: var(--text-heading-4-weight);
    color: var(--color-clean-white);
    white-space: nowrap;
  }
  .cost-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 40px;
  }

  /* ── Етапи / Лікарі / Питання ── */
  .steps,
  .doctors,
  .questions {
    padding-top: 80px;
    padding-bottom: 80px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 80px 20px;
  }
  .questions {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
    column-gap: var(--grid-gutter);
    row-gap: 40px;
  }
  .q-head {
    grid-column: 1 / span 5;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .q-head h2 {
    margin: 0;
  }
  .q-list {
    grid-column: 7 / span 6;
  }

  @media (max-width: 1199.98px) {
    .hero {
      padding-bottom: 40px;
    }
    .hero-copy,
    .hero-form,
    .head h2,
    .head-text,
    .head--steps :global(.draft-note),
    .list:first-child,
    .list:last-child,
    .q-head,
    .q-list {
      grid-column: 1 / -1;
    }
    .hero-grid {
      row-gap: 48px;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cost,
    .steps,
    .doctors,
    .questions {
      padding-top: 40px;
      padding-bottom: 40px;
    }
  }
  @media (max-width: 809.98px) {
    .hero {
      padding-top: 120px;
    }
    .hero-copy {
      gap: 16px;
    }
    /* Перший екран без скролу (ТЗ, п. 2): заголовок розміром Heading 2. */
    .title {
      font-size: var(--text-heading-2-size);
      line-height: 110%;
      letter-spacing: -0.02em;
    }
    .from-price {
      font-size: 24px;
    }
    .hero-grid {
      row-gap: 32px;
    }
    .lead {
      font-size: var(--text-body-size);
      line-height: var(--text-body-line-height);
    }
    .head {
      margin-bottom: 32px;
    }
    .list-title {
      padding: 0 16px;
      font-size: 20px;
    }
    .row {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 20px 16px;
    }
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }
</style>
